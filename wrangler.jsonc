{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Mesmo nome do Worker que já publica o site (misty-king-c67fe.luh20123.workers.dev).
  "name": "misty-king-c67fe",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Só a API passa pelo código; o resto sai direto dos arquivos, com os cabeçalhos do _headers.
    // e os endereços limpos do site (/automacao, /contato…), que entregam a página única.
    "run_worker_first": ["/api/*", "/inicio", "/automacao", "/contato", "/calculos", "/como-funciona", "/formas-de-contratacao", "/planos-de-automacao", "/termos"],
    // Endereço que não existe: mostra a página 404.html (com status 404).
    "not_found_handling": "404-page"
  },
  // Identifica o Worker de produção: com isso, um DEMO=true por engano é recusado (src/index.js).
  "vars": { "AMBIENTE": "producao" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plannex",
      "database_id": "304bc724-c72d-47d0-a719-1eaedec0611b",
      "migrations_dir": "migrations"
    }
  ],
  // Arquivos anexados aos contatos (notas fiscais e ordens de serviço). Grátis até 1 GB.
  "kv_namespaces": [
    { "binding": "ARQUIVOS", "id": "915b1d70d2cb4b86b8fdac964303aa5f" }
  ],
  // Limpeza diária de sessões vencidas e tentativas antigas (03h de Brasília).
  "triggers": { "crons": ["0 6 * * *"] },
  "observability": { "enabled": true },

  // Ambiente de demonstração: outro Worker, com banco e arquivos próprios e dados fictícios.
  // Publicar: npm run deploy:demo  ·  Endereço: plannex-demo.luh20123.workers.dev/painel/
  "env": {
    "demo": {
      "name": "plannex-demo",
      // A demonstração só liga se, além disto, o banco e os arquivos estiverem marcados como "demo"
      // (o "npm run deploy:demo" grava as marcas só nos recursos da demonstração).
      "vars": { "DEMO": "true", "AMBIENTE": "demo" },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        // A página inicial também passa pelo código, que leva direto à Central.
        "run_worker_first": ["/api/*", "/", "/index.html", "/robots.txt", "/inicio", "/automacao", "/contato", "/calculos", "/como-funciona", "/formas-de-contratacao", "/planos-de-automacao", "/termos"],
        "not_found_handling": "404-page"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "plannex-demo",
          "database_id": "74aed591-c1b2-4976-8c4d-dbafede8db2b",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        { "binding": "ARQUIVOS", "id": "2de96451aff74c3db6ff49b88bea95d3" }
      ],
      // A demonstração volta aos dados de exemplo toda madrugada (03h de Brasília).
      "triggers": { "crons": ["0 6 * * *"] }
    }
  }
}
